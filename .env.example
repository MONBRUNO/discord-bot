DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# 로스트아크 조회·시세·일정 알림을 사용하려면 API KEY / JWT를 입력하세요.
LOSTARK_API_KEY=

# 선택: 명령 등록 시 기존 서버별 명령 전체를 지워 전역 명령 중복을 정리합니다.
# 처음 설치할 때는 아래 두 변수를 주석 상태로 두세요.
# DISCORD_GUILD_ID=your_server_id_here
# 여러 서버를 정리할 때는 이 값을 사용합니다. 단일 ID보다 우선합니다.
# DISCORD_GUILD_IDS=server_id_1,server_id_2

# 알림 채널과 역할은 Discord에서 /알림설정 명령으로 설정합니다.
